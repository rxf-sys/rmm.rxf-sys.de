# rmm.rxf-sys.de — Umgebungsvariablen
# Kopieren nach .env und ausfüllen. NIEMALS die echte .env committen.

# ---- App ----
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=["https://rmm.rxf-sys.de"]
AUTH_ENABLED=true

# ---- Auth ----
# Bootstrap des ersten Admin-Accounts beim allerersten Start (leeres
# Passwort = überspringen). Nach dem ersten Login wieder leeren.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true
# Backend sitzt hinter Caddy im Compose-Netz → Proxy-Header sind vertrauenswürdig.
# (Caddy strippt sie vorher für alle Peers außer TRUSTED_PROXY_CIDR, s. u.)
TRUST_PROXY_HEADERS=true
# IP/CIDR des cloudflared-Hosts (CT 104), z. B. 192.168.2.104/32. Nur dieser
# Peer darf CF-Connecting-IP/X-Forwarded-For liefern — von allen anderen
# (direkter LAN-Zugriff) strippt Caddy die Header, sonst wäre das
# Login-Rate-Limit per gefälschtem Header umgehbar. Leer = niemandem vertrauen.
TRUSTED_PROXY_CIDR=

# ---- Storage ----
STORAGE_DB_PATH=/data/rmm.db
# Takt für Session-/Token-Aufräumen, Metrik-Rollup und hängende Jobs.
CLEANUP_INTERVAL_S=3600

# ---- Agent-Fleet ----
HEARTBEAT_INTERVAL_S=60
OFFLINE_AFTER_S=180
ENROLLMENT_TOKEN_TTL_HOURS=24

# ---- Alerts / ntfy ----
# Leerer NTFY_BASE deaktiviert Push; Alarme bleiben trotzdem im Dashboard sichtbar.
NTFY_BASE=
NTFY_TOPIC=rxf-rmm
NTFY_TOKEN=
OFFLINE_ALERT_AFTER_S=300
DISK_ALERT_PCT=90
DISK_ALERT_CLEAR_PCT=85
# Takt der Alarm-Auswertung (auch Patch-Fenster und Skript-Zeitpläne).
ALERT_INTERVAL_S=60

# ---- Jobs ----
# Per-Job-Limit für Shell-/Skript-Jobs — wird dem Agent mit jedem Job
# mitgeschickt (30 min deckt sfc/dism-artige Reparaturläufe ab).
SHELL_JOB_TIMEOUT_S=1800
# Sicherheitsnetz: Jobs, die nach dieser Zeit noch laufen/warten, werden auf
# Timeout gesetzt (Agent mittendrin abgestürzt). Der Server hebt den Wert
# automatisch auf mindestens SHELL_JOB_TIMEOUT_S + 5 min an.
JOB_TIMEOUT_S=900
# Gleiches Netz für patch_install-Jobs — der Agent erlaubt Installationen bis
# 60 min, daher deutlich höher (75 min), sonst verwirft der Server das späte
# Ergebnis des Agents.
PATCH_JOB_TIMEOUT_S=4500

# Alarm bei Sicherheitsupdates, die seit dieser Zeit offen sind.
PATCH_ALERT_AGE_DAYS=30

# ---- Update-Scans ----
# Jedes Gerät wird einmal täglich zum Update-Scan aufgefordert — ausgelöst vom
# Heartbeat, nicht von einer Uhr im Agent: Ein Gerät, das zur Slot-Zeit aus
# war, scannt beim nächsten Heartbeat nach, statt den Tag zu überspringen.
PATCH_SCAN_ENABLED=true
# Stunde des Slots in lokaler Zeit des Containers (siehe TZ in
# docker-compose.yml). Die Geräte verteilen sich über die Stunde (ID % 60).
PATCH_SCAN_HOUR=3
# Zeitzone des Backend-Containers. Bestimmt, wann PATCH_SCAN_HOUR liegt und
# wie Zeitstempel im Log aussehen. Leer/unset = Europe/Berlin (Compose-Default).
TZ=Europe/Berlin

# ---- Wake-on-LAN ----
# Broadcast-Adresse für Magic Packets. 255.255.255.255 trifft das lokale
# Segment; bei mehreren Netzen die Subnetz-Broadcast setzen (z.B. 192.168.2.255).
WOL_BROADCAST=255.255.255.255

# ---- Remote-Desktop (RustDesk, optional) ----
# Leerer RELAY_HOST deaktiviert das Remote-Panel. Setup: infrastructure/RUSTDESK.md
RUSTDESK_RELAY_HOST=
RUSTDESK_KEY=

# ---- Agent-Auto-Update ----
# Verzeichnis mit signierten Agent-Binaries + manifest.json (make sign).
# Leer = Auto-Update aus. Im Compose als ./agent-releases gemountet.
AGENT_RELEASE_DIR=/data/agent-releases

# ---- Metrik-Retention ----
# Roh-Heartbeats werden nach METRICS_RAW_RETENTION_H Stunden zu Stundenwerten
# verdichtet; die Stundenwerte fallen nach METRICS_HOURLY_RETENTION_D Tagen weg.
METRICS_RAW_RETENTION_H=48
METRICS_HOURLY_RETENTION_D=30

# ---- MDM für iOS/iPadOS (Compose-Profil `mdm`, nicht im Normalbetrieb) ----
# Beides wird erst gebraucht, wenn das APNs-Push-Zertifikat vorliegt und
# `docker compose --profile mdm up -d nanomdm` laufen soll. Anleitung:
# docs/MDM-SETUP.md
#
# Image-Tag von NanoMDM. Es gibt keine Versions-Tags, nur `main` und
# `sha-<commit>` — hier ein sha-Tag eintragen, damit sich der Server unter
# der Flotte nicht still ändert.
NANOMDM_TAG=main
# Schützt /v1/* (Push, Kommandos, Zertifikats-Upload). Leer lassen heißt:
# jeder im Docker-Netz kann jedes eingebuchte Gerät kommandieren.
# Erzeugen: openssl rand -hex 32
NANOMDM_API_KEY=
#
# SCEP-Server (Container `scep`, gleiches Profil). Passwort des
# verschlüsselten ca.key, festgelegt bei `scepserver ca -init`.
SCEP_CA_PASS=
# Statische Challenge — nur noch für das archivierte Test-Profil
# (infrastructure/_archiv/). Im Normalbetrieb LEER lassen: zusammen mit
# MDM_SCEP_VERIFY_TOKEN verweigert der scep-Container den Start.
SCEP_CHALLENGE_PASSWORD=
# Laufzeit der Geräte-Identitätszertifikate in Tagen. Das Backend erneuert
# sie MDM_RENEW_BEFORE_DAYS vor Ablauf (Compose reicht den Wert als
# MDM_IDENTITY_VALID_DAYS an das Backend weiter).
SCEP_CERT_VALID=365
#
# Registrierung aus dem Dashboard (docs/MDM-SETUP.md, Teil 6). Das Backend
# liest NANOMDM_API_KEY von oben mit.
# APNs-Topic des Push-Zertifikats (UID=com.apple.mgmt.External.… aus
# mdm/push.pem).
MDM_APNS_TOPIC=
# Signiert die Webhooks von NanoMDM an das Backend (HMAC-SHA256).
# Erzeugen: openssl rand -hex 32
MDM_WEBHOOK_SECRET=
# Einmal-Challenges: der SCEP-CSR-Verifier fragt damit das Backend.
# Erzeugen: openssl rand -hex 32
MDM_SCEP_VERIFY_TOKEN=
# Öffentlicher Ursprung im Profil und im QR-Link; Gültigkeit eines Links.
MDM_BASE_URL=https://rmm.rxf-sys.de
MDM_ENROLLMENT_TTL_HOURS=24
# Erneuerung der Geräte-Zertifikate, Inventar-Runden, iOS-Abgleich mit
# Apples Versionsliste (false = keine ausgehende Verbindung zu Apple).
# MDM_RENEW_BEFORE_DAYS=30
# MDM_REFRESH_HOURS=24
# MDM_IOS_VERSION_CHECK=true
