# rmm.rxf-sys.de — Umgebungsvariablen
# Kopieren nach .env und ausfüllen. NIEMALS die echte .env committen.

# ---- App ----
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=["https://rmm.rxf-sys.de"]
AUTH_ENABLED=true

# ---- Auth ----
# Bootstrap des ersten Admin-Accounts beim allerersten Start (leeres
# Passwort = überspringen). Nach dem ersten Login wieder leeren.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true
# Backend sitzt hinter Caddy im Compose-Netz → Proxy-Header sind vertrauenswürdig.
# (Caddy strippt sie vorher für alle Peers außer TRUSTED_PROXY_CIDR, s. u.)
TRUST_PROXY_HEADERS=true
# IP/CIDR des cloudflared-Hosts (CT 104), z. B. 192.168.2.104/32. Nur dieser
# Peer darf CF-Connecting-IP/X-Forwarded-For liefern — von allen anderen
# (direkter LAN-Zugriff) strippt Caddy die Header, sonst wäre das
# Login-Rate-Limit per gefälschtem Header umgehbar. Leer = niemandem vertrauen.
TRUSTED_PROXY_CIDR=

# ---- Storage ----
STORAGE_DB_PATH=/data/rmm.db

# ---- Agent-Fleet ----
HEARTBEAT_INTERVAL_S=60
OFFLINE_AFTER_S=180
ENROLLMENT_TOKEN_TTL_HOURS=24

# ---- Alerts / ntfy ----
# Leerer NTFY_BASE deaktiviert Push; Alarme bleiben trotzdem im Dashboard sichtbar.
NTFY_BASE=
NTFY_TOPIC=rxf-rmm
NTFY_TOKEN=
OFFLINE_ALERT_AFTER_S=300
DISK_ALERT_PCT=90
DISK_ALERT_CLEAR_PCT=85

# ---- Jobs ----
# Sicherheitsnetz: Jobs, die nach dieser Zeit noch laufen/warten, werden auf
# Timeout gesetzt (Agent mittendrin abgestürzt). Liegt über dem Agent-eigenen
# Per-Job-Timeout (Shell/Skript: 10 min).
JOB_TIMEOUT_S=900
# Gleiches Netz für patch_install-Jobs — der Agent erlaubt Installationen bis
# 60 min, daher deutlich höher (75 min), sonst verwirft der Server das späte
# Ergebnis des Agents.
PATCH_JOB_TIMEOUT_S=4500

# Alarm bei Sicherheitsupdates, die seit dieser Zeit offen sind.
PATCH_ALERT_AGE_DAYS=30

# ---- Wake-on-LAN ----
# Broadcast-Adresse für Magic Packets. 255.255.255.255 trifft das lokale
# Segment; bei mehreren Netzen die Subnetz-Broadcast setzen (z.B. 192.168.2.255).
WOL_BROADCAST=255.255.255.255

# ---- Remote-Desktop (RustDesk, optional) ----
# Leerer RELAY_HOST deaktiviert das Remote-Panel. Setup: infrastructure/RUSTDESK.md
RUSTDESK_RELAY_HOST=
RUSTDESK_KEY=

# ---- Agent-Auto-Update ----
# Verzeichnis mit signierten Agent-Binaries + manifest.json (make sign).
# Leer = Auto-Update aus. Im Compose als ./agent-releases gemountet.
AGENT_RELEASE_DIR=/data/agent-releases
