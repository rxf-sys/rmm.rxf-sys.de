:8080 {
	encode zstd gzip

	# Proxy-IP-Header nur vom bekannten cloudflared-Host (TRUSTED_PROXY_CIDR,
	# z. B. die IP von CT 104) durchlassen. Alle anderen Peers — direkter
	# LAN-Zugriff auf Port 80 — könnten CF-Connecting-IP/X-Forwarded-For frei
	# fälschen und damit das Login-Rate-Limit pro "IP" beliebig umgehen; ihre
	# Header werden gestrippt, sodass das Backend auf die echte Peer-IP
	# zurückfällt. Default 127.0.0.1/32 = niemandem vertrauen (fail-safe).
	@untrusted_proxy not remote_ip {$TRUSTED_PROXY_CIDR:127.0.0.1/32}
	request_header @untrusted_proxy -CF-Connecting-IP
	request_header @untrusted_proxy -X-Real-IP
	request_header @untrusted_proxy -X-Forwarded-For
	request_header @untrusted_proxy -X-Forwarded-Proto
	request_header @untrusted_proxy -X-Forwarded-Host

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@html path /index.html /
		header @html Cache-Control "no-cache, no-store, must-revalidate"

		# Kurze TTL für Favicons: ohne explizite Header cached Cloudflare
		# .ico/.svg an der Edge (Default ~2 h) und Browser halten Favicons
		# zusätzlich hartnäckig fest — ein Redesign käme sonst erst Stunden
		# später an.
		@icons path /favicon.ico /favicon.svg /apple-touch-icon.png /icon-192.png /icon-512.png /site.webmanifest
		header @icons Cache-Control "public, max-age=300, must-revalidate"

		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# TLS terminates at the Cloudflare edge; the header still has to be
		# emitted by the origin so browsers pin HTTPS for the domain.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 'unsafe-inline' for styles only (React style props). Scripts stay
		# strictly self-hosted; Vite emits external module bundles, no inline
		# scripts. Fonts are self-hosted (@fontsource, bundled by Vite) — no
		# external origin needed at all.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	log {
		output stdout
		format console
	}
}
