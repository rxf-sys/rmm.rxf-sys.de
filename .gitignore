# Secrets — nur .env.example ist versioniert
.env
infrastructure/.env
# Privater Update-Signaturschlüssel (aus ./build-agent.sh keygen)
infrastructure/.agent-sign.env
# MDM: APNs-Push-Zertifikat, sein privater Schlüssel, die SCEP-CA und der
# NanoMDM-Zustand. Der Push-Schlüssel ist unersetzbar — geht er verloren,
# ist auch das Zertifikat von Apple wertlos. Siehe docs/MDM-SETUP.md.
infrastructure/mdm/
mdmcert.download.*
*push.key
*push.pem
MDM_*_Certificate.pem

# Python
.venv/
venv/
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Node
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# Datenbank der End-to-End-Tests (aus tests/fixtures/seed_demo.py)
backend/e2e.db*
# Vault key the backend creates next to its database (credentials.py) —
# the e2e run puts both into backend/. A key never belongs in git.
backend/credentials.key

# Go
agent/rmm-agent
agent/dist/

# Editor/OS
.DS_Store
.idea/
.vscode/

# TS build cache
frontend/*.tsbuildinfo

# Signierte Agent-Binaries nicht einchecken (nur .gitkeep)
infrastructure/agent-releases/*
!infrastructure/agent-releases/.gitkeep
